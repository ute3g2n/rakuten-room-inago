{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.rakuten-room-kai/schemas/copy-output.schema.json",
  "title": "copy-output",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^P[0-9]{2,}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "needs_review",
              "accepted",
              "rejected"
            ]
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "product_id",
          "url",
          "body",
          "status",
          "checked_at"
        ],
        "additionalProperties": false
      }
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "target_date",
    "drafts",
    "unsupported_claims"
  ],
  "additionalProperties": false
}
