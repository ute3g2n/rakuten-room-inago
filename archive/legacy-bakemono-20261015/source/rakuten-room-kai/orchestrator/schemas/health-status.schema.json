{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.rakuten-room-kai/schemas/health-status.schema.json",
  "title": "health-status",
  "type": "object",
  "properties": {
    "target_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "scheduled",
        "missed",
        "stale_heartbeat",
        "action_required"
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "\\+09:00$"
    },
    "operation_start_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "target_date",
    "status",
    "checked_at",
    "operation_start_date",
    "run_id",
    "errors"
  ],
  "additionalProperties": false
}
