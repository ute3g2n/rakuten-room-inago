{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.rakuten-room-kai/schemas/inventory-brief.schema.json",
  "title": "inventory-brief",
  "type": "object",
  "properties": {
    "target_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "eligible_count": {
      "type": "integer",
      "minimum": 0
    },
    "draft_count": {
      "type": "integer",
      "minimum": 0
    },
    "posted_count": {
      "type": "integer",
      "minimum": 0
    },
    "shortfall_count": {
      "type": "integer",
      "minimum": 0
    },
    "genre_counts": {
      "type": "object",
      "properties": {
        "時短・料理・調理・家電": {
          "type": "integer",
          "minimum": 0
        },
        "家事ラク用品": {
          "type": "integer",
          "minimum": 0
        },
        "住まい・収納・インテリア": {
          "type": "integer",
          "minimum": 0
        },
        "子育て・キッズ用品": {
          "type": "integer",
          "minimum": 0
        },
        "親の美容・セルフケア": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "時短・料理・調理・家電",
        "家事ラク用品",
        "住まい・収納・インテリア",
        "子育て・キッズ用品",
        "親の美容・セルフケア"
      ],
      "additionalProperties": false
    },
    "needs_review_count": {
      "type": "integer",
      "minimum": 0
    },
    "inventory_shortfall_count": {
      "type": "integer",
      "minimum": 0
    },
    "eligible_product_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P\\d{2,}$"
      }
    }
  },
  "required": [
    "target_date",
    "eligible_count",
    "draft_count",
    "posted_count",
    "shortfall_count",
    "genre_counts",
    "needs_review_count",
    "inventory_shortfall_count",
    "eligible_product_ids"
  ],
  "additionalProperties": false
}
