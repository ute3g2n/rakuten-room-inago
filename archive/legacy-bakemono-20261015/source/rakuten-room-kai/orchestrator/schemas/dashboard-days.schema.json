{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.rakuten-room-kai/schemas/dashboard-days.schema.json",
  "title": "dashboard-days",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "product_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P[0-9]{2,}$"
            }
          }
        },
        "required": [
          "date",
          "product_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "days"
  ],
  "additionalProperties": false
}
