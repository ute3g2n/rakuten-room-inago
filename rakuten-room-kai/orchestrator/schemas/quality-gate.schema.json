{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.rakuten-room-kai/schemas/quality-gate.schema.json",
  "title": "quality-gate",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "accepted": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P[0-9]{2,}$"
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "required_edits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "target_date",
    "accepted",
    "rejected",
    "required_edits"
  ],
  "additionalProperties": false
}
