{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.rakuten-room-kai/schemas/room-observation.schema.json",
  "title": "room-observation",
  "type": "object",
  "properties": {
    "target_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "observed",
        "unavailable"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^P[0-9]{2,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "room_post_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "\\+09:00$"
          },
          "likes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "unavailable",
              "unmatched"
            ]
          }
        },
        "required": [
          "product_id",
          "room_post_id",
          "observed_at",
          "likes",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "target_date",
    "status",
    "observations",
    "errors"
  ],
  "additionalProperties": false
}
