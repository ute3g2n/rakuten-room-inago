  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-09-23T13:00:00+09:00</StartBoundary>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\nodejs\node.exe</Command>
      <Arguments>"C:\project\rakuten-room-bakemono\scripts\check-affiliate.mjs" check</Arguments>
      <WorkingDirectory>C:\project\rakuten-room-bakemono</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
