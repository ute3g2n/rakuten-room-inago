{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-planning-review-v1.schema.json",
  "title": "Maintenance independent planning review",
  "type": "object",
  "properties": {
    "schema_version": {"const": "maintenance-planning-review-v1"},
    "stage": {"const": "planning_review"},
    "reviewer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "review_execution_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "reviewed_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "status": {"enum": ["approved", "changes_requested", "rejected", "unavailable"]},
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
  },
  "required": ["schema_version", "stage", "reviewer_id", "review_execution_id", "reviewed_version", "status", "findings"],
  "additionalProperties": false
}
