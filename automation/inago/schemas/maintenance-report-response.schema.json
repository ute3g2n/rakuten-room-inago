{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.local/schemas/maintenance-report-response.schema.json",
  "title": "Maintenance incident report response",
  "description": "本文は平易な日本語で、発生した不具合、原因（不明なら不明）、実施した修正、追加したトレース・ログと記録内容を伝える。既存の機械互換フィールドは維持してよいが、管理分類やstage情報を本文の中心にしない。内部識別子やhashは参考付録だけに置く。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "result_version",
    "created_at_jst",
    "title",
    "summary",
    "issues",
    "flow_tree",
    "checks",
    "recovery"
  ],
  "properties": {
    "schema_version": { "const": "maintenance-report-response-v1" },
    "identity": { "$ref": "#/$defs/identity" },
    "result_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "created_at_jst": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "description": "利用者が分かる工程名で表し、内部エラー名は使わない。", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "description": "起きたこと、分かったこと、不明点を日常語でまとめる。", "minLength": 1, "maxLength": 4000 },
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/issue" }
    },
    "flow_tree": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "checks": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/check" }
    },
    "recovery": { "$ref": "#/$defs/recovery" }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_id", "source_launch_id", "source_run_id", "target_date", "job_id"],
      "properties": {
        "incident_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "source_launch_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "source_run_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "target_date": { "type": "string", "format": "date" },
        "job_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
      }
    },
    "issue": {
      "description": "機械互換フィールドを保持しつつ、本文では不具合、原因、実施した修正、追加したトレース・ログと記録内容を平易に説明する。事実と不明を混同しない。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_class", "phase", "title", "operation", "expected", "actual", "impact", "recovery",
        "cause_confidence", "cause_statement", "changed_behavior", "confirmation_scope", "evidence_ref"
      ],
      "properties": {
        "event_class": { "description": "既存構造との互換用分類。HTML reviewerは表示や分類ラベルの有無を要求しない。", "enum": ["observed", "investigation", "test"] },
        "phase": { "type": "string", "minLength": 1, "maxLength": 160 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "operation": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "expected": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "actual": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "impact": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "recovery": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "cause_confidence": { "enum": ["confirmed", "limited", "unknown"] },
        "cause_statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "changed_behavior": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "confirmation_scope": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "version", "expected", "actual", "status", "evidence_ref"],
      "properties": {
        "stage": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "expected": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "actual": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "enum": ["passed", "failed", "blocked", "not_run", "skipped", "error"] },
        "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknowns", "stop_reason", "resume_condition", "side_effects"],
      "properties": {
        "unknowns": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 100 },
        "stop_reason": { "type": ["string", "null"], "maxLength": 2000 },
        "resume_condition": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "side_effects": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
