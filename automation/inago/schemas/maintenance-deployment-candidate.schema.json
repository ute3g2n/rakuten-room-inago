{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-deployment-candidate-v1.schema.json",
  "title": "Verified repair candidate prepared for deployment",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "maintenance-deployment-candidate-v1"
    },
    "attestation_source": {
      "const": "local_pytest"
    },
    "identity": {
      "type": "object",
      "properties": {
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "source_launch_id": {
          "type": "string",
          "minLength": 1
        },
        "source_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "job_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "incident_id",
        "source_launch_id",
        "source_run_id",
        "target_date",
        "job_id"
      ],
      "additionalProperties": false
    },
    "job_id": {
      "$ref": "#/$defs/id"
    },
    "attempt_id": {
      "$ref": "#/$defs/id"
    },
    "result_version": {
      "$ref": "#/$defs/id"
    },
    "source_release": {
      "type": "object",
      "properties": {
        "release_id": {
          "$ref": "#/$defs/id"
        },
        "result_commit": {
          "$ref": "#/$defs/commit"
        },
        "config_version": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "release_id",
        "result_commit",
        "config_version"
      ],
      "additionalProperties": false
    },
    "candidate_release": {
      "type": "object",
      "properties": {
        "release_id": {
          "$ref": "#/$defs/id"
        },
        "base_commit": {
          "$ref": "#/$defs/commit"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/maintenance/candidates/[a-f0-9]{64}$"
        },
        "code_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "product_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "product_file_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "required": [
        "release_id",
        "base_commit",
        "commit",
        "ref",
        "code_sha256",
        "product_paths",
        "product_file_sha256"
      ],
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "properties": {
        "ledger": {
          "$ref": "#/$defs/artifact"
        },
        "campaign_id": {
          "$ref": "#/$defs/id"
        },
        "case_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "full_regression_receipt_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "full_regression_receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ledger",
        "campaign_id",
        "case_ids",
        "full_regression_receipt_id",
        "full_regression_receipt_sha256"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "const": "approved"
        },
        "author_id": {
          "$ref": "#/$defs/id"
        },
        "reviewer_id": {
          "$ref": "#/$defs/id"
        },
        "host_receipt_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "receipt_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed_output_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "status",
        "author_id",
        "reviewer_id",
        "host_receipt_id",
        "receipt_id",
        "receipt_sha256",
        "reviewed_output_sha256"
      ],
      "additionalProperties": false
    },
    "repair_handoff": {
      "$ref": "#/$defs/artifact"
    },
    "stage_result": {
      "$ref": "#/$defs/stage_result"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40,64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|\\\\|(^|/)\\.\\.?(/|$)|[*?\\[\\]:])"
      }
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "stage_result": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "failed",
            "unknown",
            "not_performed"
          ]
        },
        "operation_result": {
          "enum": [
            "succeeded",
            "failed",
            "unknown",
            "not_performed"
          ]
        },
        "workflow_completion": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "incident_resolution": {
          "enum": [
            "resolved",
            "unresolved",
            "unknown"
          ]
        },
        "raw_status_observation": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "artifact_origin": {
          "enum": [
            "agent",
            "controller_fallback"
          ]
        },
        "output_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "operation_result",
        "workflow_completion",
        "incident_resolution",
        "artifact_origin",
        "output_refs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "attestation_source",
    "identity",
    "job_id",
    "attempt_id",
    "result_version",
    "source_release",
    "candidate_release",
    "test",
    "review",
    "repair_handoff"
  ],
  "additionalProperties": false
}
