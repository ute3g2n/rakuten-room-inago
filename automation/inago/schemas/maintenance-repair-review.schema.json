{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-repair-review-v1.schema.json",
  "title": "Maintenance repair independent review",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "maintenance-repair-review-v1"
    },
    "attestation_source": {
      "enum": [
        "host_collected",
        "local_review"
      ]
    },
    "status": {
      "enum": [
        "approved",
        "changes_requested",
        "rejected",
        "unavailable"
      ]
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "result_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "author_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reviewer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "tested_result_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reviewed_result_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "unresolved_critical_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "tested_code_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewed_code_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "host_receipt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "receipt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "receipt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewed_output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "test_ledger_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage_result": {
      "$ref": "#/$defs/stage_result"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "source_launch_id": {
          "type": "string",
          "minLength": 1
        },
        "source_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "incident_id",
        "source_launch_id",
        "source_run_id",
        "target_date",
        "job_id"
      ],
      "additionalProperties": false
    },
    "stage_result": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "failed",
            "unknown",
            "not_performed"
          ]
        },
        "operation_result": {
          "enum": [
            "succeeded",
            "failed",
            "unknown",
            "not_performed"
          ]
        },
        "workflow_completion": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "incident_resolution": {
          "enum": [
            "resolved",
            "unresolved",
            "unknown"
          ]
        },
        "raw_status_observation": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "artifact_origin": {
          "enum": [
            "agent",
            "controller_fallback"
          ]
        },
        "output_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "operation_result",
        "workflow_completion",
        "incident_resolution",
        "artifact_origin",
        "output_refs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "attestation_source",
    "identity",
    "attempt_id",
    "result_version",
    "author_id",
    "reviewer_id",
    "tested_result_version",
    "reviewed_result_version",
    "unresolved_critical_findings",
    "tested_code_sha256",
    "reviewed_code_sha256",
    "host_receipt_id",
    "receipt_id",
    "receipt_sha256",
    "reviewed_output_sha256",
    "patch_sha256",
    "test_ledger_sha256"
  ],
  "additionalProperties": false
}
