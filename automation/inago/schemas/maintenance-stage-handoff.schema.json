{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-stage-handoff-v1.schema.json",
  "title": "Maintenance stage result and handoff",
  "type": "object",
  "properties": {
    "schema_version": {"const": "maintenance-stage-handoff-v1"},
    "handoff_id": {"$ref": "#/$defs/id"},
    "stage": {"$ref": "#/$defs/id"},
    "identity": {"$ref": "#/$defs/identity"},
    "attempt_id": {"type": ["string", "null"]},
    "operation": {"$ref": "#/$defs/id"},
    "operation_result": {"enum": ["succeeded", "failed", "unknown", "not_performed"]},
    "stage_progress": {"enum": ["content_ready_handoff_pending", "handed_off", "handoff_unavailable"]},
    "artifact_origin": {"enum": ["agent", "controller_fallback"]},
    "correlation_id": {"$ref": "#/$defs/id"},
    "captured_at": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "minLength": 1},
    "code_revision_reason": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "input_refs": {"$ref": "#/$defs/refs"},
    "output_refs": {"$ref": "#/$defs/refs"},
    "content_result": {
      "type": "object",
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "facts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "next_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "required": ["summary", "facts", "limitations", "next_actions"],
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {"$ref": "#/$defs/id"},
          "reason_code": {"type": ["string", "null"]},
          "capture_location": {"type": "string", "minLength": 1},
          "exception_chain": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "stack_frames": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "function": {"type": "string", "minLength": 1}
              },
              "required": ["file", "line", "function"],
              "additionalProperties": false
            }
          }
        },
        "required": ["operation", "reason_code", "capture_location", "exception_chain", "stack_frames"],
        "additionalProperties": false
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reason_code": {"type": "string", "minLength": 1},
    "journal_observation": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1},
        "primary_sink": {"type": "string", "minLength": 1},
        "exception_class": {"type": "string", "minLength": 1},
        "capture_location": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["status"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "handoff_id", "stage", "identity", "attempt_id", "operation", "operation_result", "stage_progress", "artifact_origin", "correlation_id", "captured_at", "code_revision", "input_refs", "output_refs", "content_result", "errors", "unknowns"],
  "allOf": [
    {
      "if": {
        "properties": {"code_revision": {"const": "unknown"}},
        "required": ["code_revision"]
      },
      "then": {
        "required": ["code_revision_reason"],
        "properties": {"code_revision_reason": {"type": "string", "minLength": 1}}
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "identity": {
      "type": "object",
      "properties": {
        "job_id": {"type": ["string", "null"]},
        "incident_id": {"type": ["string", "null"]},
        "source_launch_id": {"type": ["string", "null"]},
        "source_run_id": {"type": ["string", "null"]},
        "target_date": {"type": ["string", "null"]}
      },
      "required": ["job_id", "incident_id", "source_launch_id", "source_run_id", "target_date"],
      "additionalProperties": false
    }
  }
}
