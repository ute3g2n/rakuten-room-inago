{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/ai-job-v1.schema.json",
  "title": "AI-O root job result with native specialist delegations",
  "type": "object",
  "required": [
    "protocol_version", "schema_version", "run_id", "job_id", "attempt",
    "task_id", "agent_id", "skill_name", "target_date", "settings_version",
    "input_refs", "evidence_refs", "input_hash", "deadline_at",
    "result_status", "payload", "error", "delegations"
  ],
  "properties": {
    "protocol_version": {"const": "1"},
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "task_id": {"enum": ["T02", "T05", "T06", "T07", "T08", "T09", "T10"]},
    "agent_id": {"const": "AI-O"},
    "skill_name": {"const": "rakuten-room-inago"},
    "target_date": {"type": "string", "minLength": 10},
    "settings_version": {"type": "string", "minLength": 1},
    "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deadline_at": {"type": "string", "minLength": 20},
    "result_status": {"enum": ["success", "empty", "error"]},
    "payload": {
      "type": "object",
      "required": ["summary", "details", "references"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "details": {"type": "array", "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "error": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code", "detail"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "detail": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "delegations": {
      "type": "array",
      "items": {"$ref": "#/$defs/delegation"}
    }
  },
  "$defs": {
    "delegation": {
      "type": "object",
      "required": [
        "agent_id", "task_id", "skill_name", "input_refs", "evidence_refs",
        "result_status", "payload"
      ],
      "properties": {
        "agent_id": {"enum": ["AG-OBS", "AG-KEY", "AG-COPY", "AG-INSIGHT", "AG-CONFIG", "AG-RECOVERY"]},
        "task_id": {"enum": ["T02", "T04", "T05", "T06", "T08"]},
        "skill_name": {"enum": ["rr-inago-observation", "rr-inago-keywords", "rr-inago-copywriter", "rr-inago-insight", "rr-inago-config", "rr-inago-recovery"]},
        "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "result_status": {"enum": ["success", "empty", "error"]},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
