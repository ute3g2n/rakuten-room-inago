{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-investigation-response-v2.schema.json",
  "title": "Maintenance investigation-stage response v2",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/context"
    }
  ],
  "properties": {
    "schema_version": {
      "const": "maintenance-investigation-response-v2"
    },
    "stage": {
      "const": "investigation"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "investigation_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "non_incident_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonIncidentObservation"
      }
    },
    "verification_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "review_required": {
      "const": true
    },
    "report_markdown": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "stage",
    "summary",
    "facts",
    "investigation_limits",
    "non_incident_observations",
    "verification_candidates",
    "missing_evidence",
    "review_required",
    "report_markdown"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "context": {
      "type": "object",
      "properties": {
        "incident_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_launch_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_run_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "job_id": {
          "$ref": "#/$defs/identifier"
        },
        "attempt_id": {
          "$ref": "#/$defs/identifier"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "input_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "allowed_outputs": {}
      },
      "required": [
        "incident_id",
        "source_launch_id",
        "source_run_id",
        "target_date",
        "job_id",
        "attempt_id",
        "base_commit",
        "input_refs",
        "evidence_refs"
      ]
    },
    "fact": {
      "type": "object",
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/identifier"
        },
        "classification": {
          "enum": [
            "incident",
            "investigation",
            "test"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "actual": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "recovery": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "cause_confidence": {
          "enum": [
            "confirmed",
            "limited",
            "unknown"
          ]
        },
        "cause_statement": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "required": [
        "fact_id",
        "classification",
        "phase",
        "target_date",
        "operation",
        "expected",
        "actual",
        "impact",
        "recovery",
        "cause_confidence",
        "cause_statement",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "nonIncidentObservation": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "observation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "limits": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "item",
        "observation",
        "basis",
        "limits"
      ],
      "additionalProperties": false
    }
  }
}
