{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-repair-handoff-v1.schema.json",
  "title": "Approved maintenance repair handoff",
  "type": "object",
  "properties": {
    "schema_version": {"const": "maintenance-repair-handoff-v1"},
    "attestation_source": {"const": "host_collected"},
    "identity": {"$ref": "#/$defs/identity"},
    "job_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "attempt_no": {"type": "integer", "minimum": 1},
    "result_version": {"$ref": "#/$defs/id"},
    "plan": {
      "type": "object",
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"},
        "result_version": {"$ref": "#/$defs/id"},
        "reviewer_id": {"$ref": "#/$defs/id"},
        "output": {"$ref": "#/$defs/artifact"}
      },
      "required": ["attempt_id", "result_version", "reviewer_id", "output"],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "base_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "worktree_ref": {"type": "string", "minLength": 1},
        "product_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "product_file_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      },
      "required": ["base_commit", "code_sha256", "worktree_ref", "product_paths", "product_file_sha256"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {"const": "approved"},
        "author_id": {"$ref": "#/$defs/id"},
        "reviewer_id": {"$ref": "#/$defs/id"},
        "host_receipt_id": {"$ref": "#/$defs/id"},
        "receipt_id": {"$ref": "#/$defs/id"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed_output_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["status", "author_id", "reviewer_id", "host_receipt_id", "receipt_id", "receipt_sha256", "reviewed_output_sha256"],
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "properties": {
        "campaign_id": {"$ref": "#/$defs/id"},
        "case_count": {"type": "integer", "minimum": 1},
        "full_regression_receipt_id": {"$ref": "#/$defs/id"},
        "full_regression_receipt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["campaign_id", "case_count", "full_regression_receipt_id", "full_regression_receipt_sha256"],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "repair_setup": {"$ref": "#/$defs/artifact"},
        "implementation": {"$ref": "#/$defs/artifact"},
        "review_input": {"$ref": "#/$defs/artifact"},
        "review_response": {"$ref": "#/$defs/artifact"},
        "reviewer_output": {"$ref": "#/$defs/artifact"},
        "patch_assessment": {"$ref": "#/$defs/artifact"},
        "test_ledger": {"$ref": "#/$defs/artifact"},
        "review_target": {"$ref": "#/$defs/artifact"},
        "review": {"$ref": "#/$defs/artifact"},
        "result": {"$ref": "#/$defs/artifact"}
      },
      "required": ["repair_setup", "implementation", "review_input", "review_response", "reviewer_output", "patch_assessment", "test_ledger", "review_target", "review", "result"],
      "additionalProperties": false
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {
      "type": "object",
      "properties": {
        "incident_id": {"type": "string", "minLength": 1},
        "source_launch_id": {"type": "string", "minLength": 1},
        "source_run_id": {"type": ["string", "null"]},
        "target_date": {"type": "string", "format": "date"},
        "job_id": {"$ref": "#/$defs/id"}
      },
      "required": ["incident_id", "source_launch_id", "source_run_id", "target_date", "job_id"],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "attestation_source", "identity", "job_id", "attempt_id", "attempt_no", "result_version", "plan", "candidate", "review", "test", "artifacts"],
  "additionalProperties": false
}
