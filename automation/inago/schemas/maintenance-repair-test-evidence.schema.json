{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-repair-test-evidence-v1.schema.json",
  "title": "Maintenance repair isolated test-run evidence",
  "type": "object",
  "properties": {
    "node": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "SKIP",
        "XFAIL",
        "ERROR",
        "NOT_RUN",
        "UNVERIFIED"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "collected": {
      "type": "integer",
      "minimum": 0
    },
    "assertion_failures": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "code_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semantic_case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "invocation_parent_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "collection_errors": {
      "type": "integer",
      "minimum": 0
    },
    "execution_kind": {
      "enum": [
        "in_process_callable",
        "pytest"
      ]
    },
    "stage_result": {
      "$ref": "#/$defs/stage_result"
    }
  },
  "required": [
    "node",
    "outcome",
    "exit_code",
    "collected",
    "assertion_failures",
    "errors",
    "code_sha256",
    "semantic_case_id",
    "invocation_parent_id",
    "collection_errors",
    "execution_kind"
  ],
  "additionalProperties": false,
  "$defs": {
    "stage_result": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "failed",
            "unknown",
            "not_performed"
          ]
        },
        "operation_result": {
          "enum": [
            "succeeded",
            "failed",
            "unknown",
            "not_performed"
          ]
        },
        "workflow_completion": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "incident_resolution": {
          "enum": [
            "resolved",
            "unresolved",
            "unknown"
          ]
        },
        "raw_status_observation": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "artifact_origin": {
          "enum": [
            "agent",
            "controller_fallback"
          ]
        },
        "output_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "operation_result",
        "workflow_completion",
        "incident_resolution",
        "artifact_origin",
        "output_refs"
      ],
      "additionalProperties": false
    }
  }
}
