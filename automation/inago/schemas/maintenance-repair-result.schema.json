{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-repair-result-v1.schema.json",
  "title": "Maintenance repair completion result",
  "type": "object",
  "properties": {
    "schema_version": {"const": "maintenance-repair-result-v1"},
    "attestation_source": {"const": "host_collected"},
    "identity": {"$ref": "#/$defs/identity"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "result_version": {"$ref": "#/$defs/id"},
    "tested_code_sha256": {"$ref": "#/$defs/sha256"},
    "repair_status": {"const": "complete"},
    "completion_status": {"const": "ready"},
    "review_status": {"const": "approved"},
    "output": {
      "type": "object",
      "properties": {
        "patch_assessment": {"$ref": "#/$defs/artifact"},
        "test_ledger": {"$ref": "#/$defs/artifact"},
        "review_target": {"$ref": "#/$defs/artifact"},
        "review": {"$ref": "#/$defs/artifact"}
      },
      "required": ["patch_assessment", "test_ledger", "review_target", "review"],
      "additionalProperties": false
    },
    "reviewer_id": {"$ref": "#/$defs/id"},
    "reviewed_result_version": {"$ref": "#/$defs/id"},
    "reviewed_code_sha256": {"$ref": "#/$defs/sha256"},
    "reviewed_output_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {
      "type": "object",
      "properties": {
        "incident_id": {"type": "string", "minLength": 1},
        "source_launch_id": {"type": "string", "minLength": 1},
        "source_run_id": {"type": ["string", "null"]},
        "target_date": {"type": "string", "format": "date"},
        "job_id": {"type": "string", "minLength": 1}
      },
      "required": ["incident_id", "source_launch_id", "source_run_id", "target_date", "job_id"],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}},
      "required": ["path", "sha256"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "attestation_source", "identity", "attempt_id", "result_version", "tested_code_sha256", "repair_status", "completion_status", "review_status", "output", "reviewer_id", "reviewed_result_version", "reviewed_code_sha256", "reviewed_output_sha256"],
  "additionalProperties": false
}
