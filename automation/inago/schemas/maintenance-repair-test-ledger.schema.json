{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-repair-test-ledger-v1.schema.json",
  "title": "Maintenance repair test ledger artifact",
  "type": "object",
  "properties": {
    "schema_version": {"const": "maintenance-repair-test-ledger-v1"},
    "attestation_source": {"enum": ["host_collected", "local_pytest"]},
    "identity": {"$ref": "#/$defs/identity"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "result_version": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "code_sha256": {"$ref": "#/$defs/sha256"},
    "tested_code_sha256": {"$ref": "#/$defs/sha256"},
    "invocation_parent_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "semantic_signatures": {"type": "array", "items": {"$ref": "#/$defs/signature"}, "minItems": 1},
    "frozen_cases": {"type": "array", "items": {"$ref": "#/$defs/frozen_case"}},
    "frozen_pass_receipts": {"type": "array", "items": {"$ref": "#/$defs/frozen_pass_receipt"}},
    "required_cases": {"type": "array", "items": {"$ref": "#/$defs/case"}, "minItems": 1},
    "results": {"type": "array", "items": {"$ref": "#/$defs/case_results"}},
    "full_regression": {"oneOf": [{"$ref": "#/$defs/full_regression"}, {"type": "null"}]},
    "c34_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {
      "type": "object",
      "properties": {
        "incident_id": {"type": "string", "minLength": 1},
        "source_launch_id": {"type": "string", "minLength": 1},
        "source_run_id": {"type": ["string", "null"]},
        "target_date": {"type": "string", "format": "date"},
        "job_id": {"type": "string", "minLength": 1}
      },
      "required": ["incident_id", "source_launch_id", "source_run_id", "target_date", "job_id"],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {"semantic_case_id": {"$ref": "#/$defs/id"}, "node": {"type": "string", "minLength": 1}},
      "required": ["semantic_case_id", "node"],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {"semantic_case_id": {"$ref": "#/$defs/id"}, "signature": {"type": "string", "minLength": 1}},
      "required": ["semantic_case_id", "signature"],
      "additionalProperties": false
    },
    "frozen_case": {
      "type": "object",
      "properties": {
        "semantic_case_id": {"$ref": "#/$defs/id"},
        "node": {"type": "string", "minLength": 1},
        "semantic_signature": {"type": "string", "minLength": 1}
      },
      "required": ["semantic_case_id", "node", "semantic_signature"],
      "additionalProperties": false
    },
    "frozen_pass_receipt": {
      "type": "object",
      "properties": {
        "semantic_case_id": {"$ref": "#/$defs/id"},
        "node": {"type": "string", "minLength": 1},
        "semantic_signature": {"type": "string", "minLength": 1},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_id": {"$ref": "#/$defs/id"},
        "receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "outcome": {"const": "PASS"}
      },
      "required": ["semantic_case_id", "node", "semantic_signature", "code_sha256", "receipt_id", "receipt_sha256", "outcome"],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "outcome": {"enum": ["PASS", "FAIL", "NOT_RUN", "SKIP", "XFAIL", "ERROR", "UNVERIFIED"]},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "required": ["outcome", "code_sha256"],
      "additionalProperties": false
    },
    "case_results": {
      "type": "object",
      "properties": {"semantic_case_id": {"$ref": "#/$defs/id"}, "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}}},
      "required": ["semantic_case_id", "runs"],
      "additionalProperties": false
    },
    "full_regression": {
      "type": "object",
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "receipt_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "token": {"$ref": "#/$defs/id"},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}, "minItems": 1},
        "results": {"type": "array", "items": {"$ref": "#/$defs/full_result"}},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "collected": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skips": {"type": "integer", "minimum": 0},
        "collection_errors": {"type": "integer", "minimum": 0},
        "invocation_parent_id": {"type": "null"}
      },
      "required": ["run_id", "receipt_id", "receipt_sha256", "token", "code_sha256", "cases", "results", "exit_code", "collected", "errors", "skips", "collection_errors", "invocation_parent_id"],
      "additionalProperties": false
    },
    "full_result": {
      "type": "object",
      "properties": {"semantic_case_id": {"$ref": "#/$defs/id"}, "outcome": {"enum": ["PASS", "FAIL", "ERROR", "SKIP", "NOT_RUN", "UNVERIFIED"]}},
      "required": ["semantic_case_id", "outcome"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "node": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["PASS", "FAIL", "SKIP", "XFAIL", "ERROR", "NOT_RUN", "UNVERIFIED"]},
        "exit_code": {"type": "integer"},
        "collected": {"type": "integer", "minimum": 0},
        "assertion_failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_case_id": {"$ref": "#/$defs/id"},
        "invocation_parent_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "collection_errors": {"type": "integer", "minimum": 0},
        "execution_kind": {"enum": ["in_process_callable", "pytest"]}
      },
      "required": ["node", "outcome", "exit_code", "collected", "assertion_failures", "errors", "code_sha256", "semantic_case_id", "invocation_parent_id", "collection_errors", "execution_kind"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "attestation_source", "identity", "attempt_id", "result_version", "campaign_id", "code_sha256", "tested_code_sha256", "invocation_parent_id", "semantic_signatures", "frozen_cases", "frozen_pass_receipts", "required_cases", "results", "full_regression", "c34_evidence"],
  "additionalProperties": false
}
