{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/ai-insight-v1.schema.json",
  "title": "AG-INSIGHT scoped analysis result",
  "type": "object",
  "required": ["scope", "findings"],
  "properties": {
    "scope": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "evidence_refs", "comparison_basis", "limitations"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "comparison_basis": {"type": "string", "minLength": 1},
          "limitations": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
