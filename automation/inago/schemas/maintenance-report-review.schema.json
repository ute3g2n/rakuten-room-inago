{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.local/schemas/maintenance-report-review.schema.json",
  "title": "Maintenance incident report review",
  "description": "HTML独立レビューは、発生した不具合、原因（不明なら不明）、実施した修正、追加したトレース・ログとその記録内容の4点に絞る。欠落、事実誤認、根拠のない断定、理解を妨げる表現を指摘する。秘密・個人情報の露出も確認する。それ以外のHTML要素はレビュー対象外とする。発生区分、合成例表示、管理資料リンク、版対応表、工程status、review/publication/terminal間の管理情報は指摘対象にしない。試験PASSは前提とし、分類ラベルを要求しない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewer_id", "reviewed_version", "reviewed_sha256", "status", "reviewed_at", "findings"],
  "properties": {
    "schema_version": { "const": "maintenance-report-review-v1" },
    "reviewer_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "reviewed_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "reviewed_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["approved", "changes_requested", "rejected", "unavailable"] },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "location", "finding"],
        "properties": {
          "severity": { "enum": ["low", "medium", "high"] },
          "location": { "type": "string", "minLength": 1, "maxLength": 512 },
          "finding": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
