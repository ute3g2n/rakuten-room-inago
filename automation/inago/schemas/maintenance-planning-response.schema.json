{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-planning-response-v1.schema.json",
  "title": "Maintenance planning-stage response",
  "type": "object",
  "$defs": {
    "textValues": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "section": {
      "type": "object",
      "properties": {
        "number": {"type": "integer", "minimum": 0, "maximum": 14},
        "title": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1}
      },
      "required": ["number", "title", "content"],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "name": {"type": "string", "minLength": 1},
            "status": {"enum": ["planned", "blocked", "complete"]}
          },
          "required": ["number", "name", "status"],
          "additionalProperties": false
        },
        "purpose": {"$ref": "#/$defs/textValues"},
        "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "predecessors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "ownership": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "procedure": {"$ref": "#/$defs/textValues"},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "constraints": {"$ref": "#/$defs/textValues"},
        "review": {"$ref": "#/$defs/textValues"},
        "acceptance_evidence": {"$ref": "#/$defs/textValues"},
        "failure_recovery": {"$ref": "#/$defs/textValues"},
        "handoff": {"$ref": "#/$defs/textValues"},
        "full_prompt": {"type": "string", "minLength": 300}
      },
      "required": ["identity", "purpose", "requirements", "predecessors", "inputs", "ownership", "procedure", "outputs", "constraints", "review", "acceptance_evidence", "failure_recovery", "handoff", "full_prompt"],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "node": {"type": "string", "minLength": 1},
        "requirement_step": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "requirement_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
              "step_number": {"type": "integer", "minimum": 1}
            },
            "required": ["requirement_id", "step_number"],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "purpose": {"$ref": "#/$defs/textValues"},
        "kind_method": {"$ref": "#/$defs/textValues"},
        "preconditions": {"$ref": "#/$defs/textValues"},
        "inputs_operations": {"$ref": "#/$defs/textValues"},
        "execution_configuration": {"$ref": "#/$defs/textValues"},
        "expected_output": {"$ref": "#/$defs/textValues"},
        "expected_state_logs": {"$ref": "#/$defs/textValues"},
        "forbidden_side_effects": {"$ref": "#/$defs/textValues"},
        "pass_criteria": {"$ref": "#/$defs/textValues"},
        "evidence": {"$ref": "#/$defs/textValues"},
        "cleanup_retry": {"$ref": "#/$defs/textValues"}
      },
      "required": ["case_id", "node", "requirement_step", "purpose", "kind_method", "preconditions", "inputs_operations", "execution_configuration", "expected_output", "expected_state_logs", "forbidden_side_effects", "pass_criteria", "evidence", "cleanup_retry"],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "step_numbers": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "required": ["requirement_id", "fact_ids", "evidence_refs", "step_numbers", "case_ids"],
      "additionalProperties": false
    },
    "causeAction": {
      "type": "object",
      "properties": {
        "fact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "action": {"enum": ["verify_only", "hold", "repair_verified"]},
        "basis": {"type": "string", "minLength": 1}
      },
      "required": ["fact_id", "action", "basis"],
      "additionalProperties": false
    },
    "fieldBinding": {
      "type": "object",
      "properties": {
        "field": {"enum": ["source_run_id", "overall_status", "daily_status", "reason_code", "failure_phase", "trace_status", "missing_reason"]},
        "schema_ref": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "case_id": {"const": "C32"}
      },
      "required": ["field", "schema_ref", "source_ref", "case_id"],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": "maintenance-planning-response-v1"},
    "stage": {"const": "planning"},
    "status": {"enum": ["ready", "waiting_external", "blocked"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "sections": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/section"}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/step"}},
    "cases": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/case"}},
    "coverage": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/coverage"}},
    "cause_actions": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/causeAction"}},
    "logging_contract": {
      "type": "object",
      "properties": {
        "source_run_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "overall_status": {"type": "string", "minLength": 1},
        "daily_status": {"type": "string", "minLength": 1},
        "reason_code": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "failure_phase": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "trace_status": {"enum": ["healthy", "degraded", "unavailable", "not_written"]},
        "missing_reason": {"enum": ["source_run_not_saved", "trace_not_written", "trace_unavailable", "trace_degraded", "none"]},
        "field_bindings": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/fieldBinding"}}
      },
      "required": ["source_run_id", "overall_status", "daily_status", "reason_code", "failure_phase", "trace_status", "missing_reason", "field_bindings"],
      "additionalProperties": false
    },
    "hold_conditions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "final_explanation": {"type": "string", "minLength": 1, "maxLength": 4000},
    "review_required": {"const": true}
  },
  "required": ["schema_version", "stage", "status", "summary", "sections", "steps", "cases", "coverage", "cause_actions", "logging_contract", "hold_conditions", "final_explanation", "review_required"],
  "unevaluatedProperties": false
}
