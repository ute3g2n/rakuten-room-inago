{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-repair-patch-v1.schema.json",
  "title": "Maintenance repair patch ownership and assertion snapshot",
  "type": "object",
  "properties": {
    "changed_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "owned_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "baseline_assertions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "string", "minLength": 1}
      }
    },
    "candidate_assertions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "string", "minLength": 1}
      }
    }
  },
  "required": ["changed_paths", "owned_paths", "baseline_assertions", "candidate_assertions"],
  "additionalProperties": false
}
