{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-repair-patch-assessment-v1.schema.json",
  "title": "Maintenance repair patch assessment artifact",
  "type": "object",
  "properties": {
    "schema_version": {"const": "maintenance-repair-patch-assessment-v1"},
    "attestation_source": {"const": "local_pytest"},
    "identity": {"$ref": "#/$defs/identity"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "result_version": {"$ref": "#/$defs/id"},
    "tested_code_sha256": {"$ref": "#/$defs/sha256"},
    "assessment": {
      "type": "object",
      "properties": {
        "accepted": {"type": "boolean"},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "changed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "assertion_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["accepted", "reason_codes", "changed_paths", "assertion_snapshot_sha256"],
      "additionalProperties": false
    },
    "owned_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "baseline_assertions": {"$ref": "#/$defs/assertions"},
    "candidate_assertions": {"$ref": "#/$defs/assertions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {
      "type": "object",
      "properties": {
        "incident_id": {"type": "string", "minLength": 1},
        "source_launch_id": {"type": "string", "minLength": 1},
        "source_run_id": {"type": ["string", "null"]},
        "target_date": {"type": "string", "format": "date"},
        "job_id": {"type": "string", "minLength": 1}
      },
      "required": ["incident_id", "source_launch_id", "source_run_id", "target_date", "job_id"],
      "additionalProperties": false
    },
    "assertions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "additionalProperties": {"type": "string", "minLength": 1}
      }
    }
  },
  "required": ["schema_version", "attestation_source", "identity", "attempt_id", "result_version", "tested_code_sha256", "assessment", "owned_paths", "baseline_assertions", "candidate_assertions"],
  "additionalProperties": false
}
