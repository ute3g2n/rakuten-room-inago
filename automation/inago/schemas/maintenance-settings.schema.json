{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/maintenance-settings-v1.schema.json",
  "title": "Maintenance-only settings",
  "type": "object",
  "required": [
    "schema_version",
    "settings_version",
    "timezone",
    "lease_heartbeat_seconds",
    "watchdog_interval_seconds",
    "ai_job_timeout_seconds",
    "cancellation_confirmation_timeout_seconds",
    "request_retry_limit",
    "diagnostic_log_retention_days",
    "diagnostic_log_max_file_bytes",
    "diagnostic_failure_journal_filename"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "settings_version": { "enum": ["1.0", "1.1", "1.2", "1.3", "1.4", "1.5", "1.6"] },
    "timezone": { "const": "Asia/Tokyo" },
    "code_fix_concurrency": {
      "type": "integer",
      "deprecated": true,
      "description": "Legacy compatibility input for settings 1.0-1.4; any integer is ignored and never limits job starts."
    },
    "lease_heartbeat_seconds": { "const": 30 },
    "watchdog_interval_seconds": { "const": 60 },
    "ai_job_timeout_seconds": { "const": 1200 },
    "cancellation_confirmation_timeout_seconds": { "const": 60 },
    "request_retry_limit": { "const": 2 },
    "review_round_limit": {
      "type": "integer",
      "deprecated": true,
      "description": "Legacy compatibility input only; ignored and never limits review cycles."
    },
    "job_resume_limit": {
      "type": "integer",
      "deprecated": true,
      "description": "Legacy compatibility input only; ignored and never limits job resumption."
    },
    "diagnostic_log_retention_days": { "const": 90 },
    "diagnostic_log_max_file_bytes": { "const": 4194304 },
    "diagnostic_failure_journal_filename": { "const": "events.jsonl" },
    "diagnostic_log_max_files_per_day": {
      "type": "integer",
      "deprecated": true,
      "description": "Legacy input accepted for compatibility; ignored by maintenance logging."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "settings_version": { "enum": ["1.0", "1.1", "1.2", "1.3", "1.4"] } },
        "required": ["settings_version"]
      },
      "then": { "required": ["code_fix_concurrency"] }
    },
    {
      "if": {
        "properties": { "settings_version": { "const": "1.5" } },
        "required": ["settings_version"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["code_fix_concurrency"] },
            { "required": ["review_round_limit"] },
            { "required": ["job_resume_limit"] },
            { "required": ["diagnostic_log_max_files_per_day"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "settings_version": { "const": "1.6" } },
        "required": ["settings_version"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["code_fix_concurrency"] },
            { "required": ["review_round_limit"] },
            { "required": ["job_resume_limit"] },
            { "required": ["diagnostic_log_max_files_per_day"] }
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
