{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakuten-room-inago.invalid/schemas/ai-observation-v1.schema.json",
  "title": "AG-OBS observation result",
  "type": "object",
  "required": ["field", "value", "position", "ref", "availability", "unknown_reason"],
  "properties": {
    "field": {"type": "string", "minLength": 1},
    "value": {
      "anyOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "integer"},
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "position": {
      "anyOf": [
        {"type": "string"},
        {"type": "integer"},
        {"type": "null"}
      ]
    },
    "ref": {"type": "string", "minLength": 1},
    "availability": {"enum": ["observed", "unknown", "unavailable", "not_present"]},
    "unknown_reason": {
      "anyOf": [{"type": "string"}, {"type": "null"}]
    }
  },
  "additionalProperties": false
}
